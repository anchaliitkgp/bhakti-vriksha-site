# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# ─── NextAuth ─────────────────────────────────────────────────
# Local: http://localhost:3000 · Production: your Vercel URL
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── Google OAuth ─────────────────────────────────────────────
# From https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Supabase ─────────────────────────────────────────────────
# From https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://paeetsgehvhahaibmpsj.supabase.co
# Service role key is server-only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBhZWV0c2dlaHZoYWhhaWJtcHNqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3ODI5OTM1OCwiZXhwIjoyMDkzODc1MzU4fQ.7j0pRUyYekP3KVuZHiJYmCOq9rl4T-1kjaqzcOXN-HI

